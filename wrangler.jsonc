{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playnest",
  "account_id": "eea9b01d768c47bcb3798afa3376c968",
  // worker/index.ts serves the app (packed into dist-worker/files.js by scripts/embed-worker.mjs)
  // and the /api/ai/* endpoints. The ANTHROPIC_API_KEY secret is set in the Cloudflare dashboard.
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "AI_USAGE", "id": "defdc53252034a369e9fb18d69ab48e2" }],
  "vars": { "AI_DAILY_PER_DEVICE": "10", "AI_DAILY_TOTAL": "300" },
  "observability": { "enabled": true }
}
